#!/usr/bin/env python3
import sys
import os
import re

# ASCII Banner for CheckPDF
BANNER = r"""
  _____ _               _    ____  ____  _____ 
 /  __ \ |             | |  |  _ \|  _ \|  ___|
/  /  \/\ |__   ___  __| | _| |_) | | | | |_   

|  |    | '_ \ / _ \/ __| |/ /  __/| |_| |  _|  
\  \__/\| | | |  __/ (__|   <| |   |____/|_|    
 \_____/|_| |_|\___|\___|_|\_\_|   |_|          
               
     [=] PDF Script Extractor Tool [=]
"""

def extract_javascript(pdf_path, output_path=None):
    if not os.path.exists(pdf_path):
        print(f"[-] Error: File '{pdf_path}' not found.")
        sys.exit(1)

    print(f"[*] Analyzing file: {pdf_path}")
    
    with open(pdf_path, 'rb') as f:
        content = f.read()

    # Search for potential JS scripts according to PDF specifications
    js_patterns = [
        re.compile(br'/JavaScript\s*<<([^>]+)>>'),
        re.compile(br'/JS\s*\((.*?)\)'),
        re.compile(br'/JS\s*<<([^>]+)>>'),
        re.compile(br'/AA\s*<<([^>]+)>>') # Automated actions trigger
    ]

    extracted_scripts = []
    
    for pattern in js_patterns:
        matches = pattern.findall(content)
        for match in matches:
            try:
                script_text = match.decode('utf-8', errors='ignore').strip()
                if script_text and script_text not in extracted_scripts:
                    extracted_scripts.append(script_text)
            except Exception:
                continue

    if not extracted_scripts:
        print("[+] No JavaScript scripts or hidden triggers detected.")
        return

    print(f"[!] Warning! Suspicious objects found: {len(extracted_scripts)}")
    
    for i, script in enumerate(extracted_scripts, 1):
        print(f"\n--- Script #{i} ---")
        print(script)
        
        if output_path:
            out_file = f"{output_path}_script_{i}.js"
            with open(out_file, 'w', encoding='utf-8') as out:
                out.write(script)
            print(f"[+] Script successfully extracted to: {out_file}")

def main():
    print(BANNER)

    if len(sys.argv) < 2:
        print("Usage: checkpdf <path_to_pdf> [output_prefix]")
        print("Example: checkpdf sample.pdf extracted_js\n")
        sys.exit(1)

    pdf_path = sys.argv[1]
    output_path = sys.argv[2] if len(sys.argv) > 2 else None
    
    extract_javascript(pdf_path, output_path)

if __name__ == "__main__":
    main()
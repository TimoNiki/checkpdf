#!/usr/bin/env python3
import sys
import os
import re

# Красивый ASCII баннер для CheckPDF
BANNER = r"""
  _____ _               _    ____  ____  _____ 
 /  __ \ |             | |  |  _ \|  _ \|  ___|
/  /  \/\ |__   ___  __| | _| |_) | | | | |_   

|  |    | '_ \ / _ \/ __| |/ /  __/| |_| |  _|  
\  \__/\| | | |  __/ (__|   <| |   |____/|_|    
 \_____/|_| |_|\___|\___|_|\_\_|   |_|          
               
     [=] PDF Script Extractor Tool [=]
"""

def extract_javascript(pdf_path, output_path=None):
    if not os.path.exists(pdf_path):
        print(f"[-] Ошибка: Файл '{pdf_path}' не найден.")
        sys.exit(1)

    print(f"[*] Анализ файла: {pdf_path}")
    
    with open(pdf_path, 'rb') as f:
        content = f.read()

    # Поиск потенциальных JS-скриптов по спецификации PDF
    js_patterns = [
        re.compile(br'/JavaScript\s*<<([^>]+)>>'),
        re.compile(br'/JS\s*\((.*?)\)'),
        re.compile(br'/JS\s*<<([^>]+)>>'),
        re.compile(br'/AA\s*<<([^>]+)>>') # Дополнительно ищем автоматические действия
    ]

    extracted_scripts = []
    
    for pattern in js_patterns:
        matches = pattern.findall(content)
        for match in matches:
            try:
                # Очищаем от мусора и декодируем
                script_text = match.decode('utf-8', errors='ignore').strip()
                if script_text and script_text not in extracted_scripts:
                    extracted_scripts.append(script_text)
            except Exception:
                continue

    if not extracted_scripts:
        print("[+] Скриптов JavaScript или скрытых триггеров не обнаружено.")
        return

    print(f"[!] Внимание! Найдено подозрительных объектов: {len(extracted_scripts)}")
    
    for i, script in enumerate(extracted_scripts, 1):
        print(f"\n--- Скрипт #{i} ---")
        print(script)
        
        if output_path:
            out_file = f"{output_path}_script_{i}.js"
            with open(out_file, 'w', encoding='utf-8') as out:
                out.write(script)
            print(f"[+] Скрипт успешно выгружен в: {out_file}")

def main():
    # Выводим баннер сразу при запуске утилиты
    print(BANNER)

    if len(sys.argv) < 2:
        print("Использование: checkpdf <путь_к_pdf> [префикс_для_сохранения]")
        print("Пример: checkpdf sample.pdf extracted_js\n")
        sys.exit(1)

    pdf_path = sys.argv[1]
    output_path = sys.argv[2] if len(sys.argv) > 2 else None
    
    extract_javascript(pdf_path, output_path)

if __name__ == "__main__":
    main()